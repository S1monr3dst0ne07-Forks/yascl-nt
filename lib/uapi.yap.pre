

#include <asm/stat.h>
#include <asm/fcntl.h>
#include <asm/errno.h>
#include <linux/fs.h>

#include <linux/time.h>
#define __timeval_defined

#include <netinet/in.h>
#include "dirent.h"


seq FS::Struct::Stat
{
    MODE = `offsetof(struct stat, st_mode)`,
    SIZE = `offsetof(struct stat, st_size)`,
}

seq FS::Struct::Dirent
{
    RECLEN = `offsetof(struct linux_dirent, d_reclen)`,
    NAME   = `offsetof(struct linux_dirent, d_name)`,
}

seq FS::Mode
{
    RDONLY = `O_RDONLY`,
    WRONLY = `O_WRONLY`,
    RDWR   = `O_RDWR`,
    CREATE = `O_CREAT`,
    TRUNC  = `O_TRUNC`,
}

seq FS::Seek::Mode
{
    SEEK_SET = `SEEK_SET`,
    SEEK_CUR = `SEEK_CUR`,
    SEEK_END = `SEEK_END`,
}

seq FS::Dir::Type
{
    UNKNOWN   = `DT_UNKNOWN`,
    FIFO      = `DT_FIFO`,
    CHAR_DEV  = `DT_CHR`,
    DIR       = `DT_DIR`,
    BLOCK_DEV = `DT_BLK`,
    FILE      = `DT_REG`,
    LINK      = `DT_LNK`,
    UNIX_SOCK = `DT_SOCK`,
}


seq Net::AF
{
    UNSPEC = `AF_UNSPEC`,
    UNIX   = `AF_UNIX`,
    INET   = `AF_INET`,
}

seq Net::Sock
{
	STREAM	  = `SOCK_STREAM`,
	DGRAM	  = `SOCK_DGRAM`,
	RAW       = `SOCK_RAW`,
}

seq Net::Struct::sockaddr_in
    // in bit count format.
{
    sin_family = `offsetof(struct sockaddr_in, sin_family) * 8`, 
    sin_port   = `offsetof(struct sockaddr_in, sin_port  ) * 8`, 
    sin_addr   = `offsetof(struct sockaddr_in, sin_addr  ) * 8`,
}

seq Net::SockOptionLevel
{
    SOCKET = `SOL_SOCKET`, 
}
seq Net::SockOption
{
    REUSEADDR = `SO_REUSEADDR`,
    RCVTIMEO  = `SO_RCVTIMEO`,
}

seq Time::Val
    // in user qword format
{
    SEC  = `offsetof(struct timeval, tv_sec ) >> 3`,
    USEC = `offsetof(struct timeval, tv_usec) >> 3`,
    __last = `sizeof(struct timeval) - 1`,
}

seq Time::Spec
	// in user qword format
{
	SEC  = `offsetof(struct timespec, tv_sec ) >> 3`,
	NSEC = `offsetof(struct timespec, tv_nsec) >> 3`,
	__last = `sizeof(struct timespec) - 1`,
}

seq Time::Clock
{
	MONOTONIC = `CLOCK_MONOTONIC`,
}
seq Time::Timer
{
	ABSTIME = `TIMER_ABSTIME`,
}


